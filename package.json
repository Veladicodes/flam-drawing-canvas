{
  "name": "flam-drawing-canvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,party -c cyan,magenta \"npm:dev:web\" \"npm:dev:party\"",
    "dev:web": "vite",
    "dev:party": "partykit dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy:party": "partykit deploy",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "nanoid": "^5.0.9",
    "partysocket": "^1.1.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "concurrently": "^9.1.2",
    "partykit": "^0.0.115",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  }
}
